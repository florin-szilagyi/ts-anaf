# Postgres (any provider — plain wire protocol via postgres.js)
DATABASE_URL=postgres://user:pass@localhost:5432/fastbill

# 32 random bytes, base64 — encrypts ANAF tokens at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FASTBILL_ENCRYPTION_KEY=

# ANAF OAuth app (registered in SPV → DEZVOLTATORI APLICAȚII)
ANAF_CLIENT_ID=
ANAF_CLIENT_SECRET=
ANAF_REDIRECT_URI=https://localhost:3000/api/anaf/callback

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# S3-compatible object storage (Cloudflare R2, Supabase Storage, MinIO, AWS S3)
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=fastbill

# Upstash Redis (rate limiting + caching). Leave empty in local dev to use the
# in-memory fallback limiter (single-process only).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Inngest (empty in local dev — the inngest dev server discovers /api/inngest)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

NEXT_PUBLIC_APP_URL=http://localhost:3000
