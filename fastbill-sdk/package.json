{
  "name": "@florinszilagyi/fastbill-sdk",
  "version": "0.1.0",
  "description": "Typed TypeScript client for the fastbill e-Factura API (invoices, companies, downloads) — the canonical request/response contract",
  "keywords": ["fastbill", "anaf", "e-factura", "efactura", "romania", "invoice", "api-client"],
  "license": "MIT",
  "author": "Florin Szilagyi",
  "repository": {
    "type": "git",
    "url": "https://github.com/florin-szilagyi/ts-anaf.git",
    "directory": "fastbill-sdk"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "files": ["dist/**/*", "README.md"],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.json",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint 'src/**/*.ts' 'tests/**/*.ts' --fix",
    "lint:check": "eslint 'src/**/*.ts' 'tests/**/*.ts'",
    "test": "jest",
    "verify": "pnpm run lint:check && pnpm run build && pnpm run test"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.5",
    "jest": "^29.7.0",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": ["**/tests/**/*.test.ts"]
  }
}
